# Skyfarer -Environment Configuration
# --------------------------------------------------------
# Copy this file to .env and fill in your values.
#
# Only three things are always read from here: SKYFARER_SECRET_KEY, the
# Postgres connection and the dashboard's address (marked "always .env").
# Everything else is imported into the database on the first start, and from
# then on is changed in the dashboard under Settings; editing it here
# afterwards has no effect.

# ── Secret key (always .env) ─────────────────────────────
# Required. Encrypts the keys, passwords and tokens stored in the database,
# and signs dashboard sessions. Make one with: openssl rand -hex 32
# Keep it safe and don't change it: stored secrets can't be read without it.
SKYFARER_SECRET_KEY=

# ── Zendesk ──────────────────────────────────────────────
# Optional, as long as at least one notification channel is set up. Leave all
# three blank to run without tickets.
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=you@example.com
ZENDESK_API_TOKEN=

# ── ServiceNow ───────────────────────────────────────────
# Optional, like Zendesk: creates a record per incident (in the incident table
# by default), adds provider updates as work notes, and resolves it when the
# provider says the incident is over. Leave SERVICENOW_INSTANCE blank to turn
# it off. The instance name (yourcompany for yourcompany.service-now.com) or
# its full URL.
SERVICENOW_INSTANCE=
# An integration user with the itil role (or rest_api_explorer plus write
# access to the table), or an OAuth bearer token instead.
SERVICENOW_USER=
SERVICENOW_PASSWORD=
# SERVICENOW_TOKEN=
# SERVICENOW_TABLE=incident
# 1 (high) to 3 (low).
SERVICENOW_IMPACT=2
SERVICENOW_URGENCY=2
# A group's sys_id or name, a caller's sys_id or user name, and a category.
SERVICENOW_ASSIGNMENT_GROUP=
SERVICENOW_CALLER=
SERVICENOW_CATEGORY=
# When the provider says it's over: true sets the record to Resolved (state 6)
# with the close code below, and ServiceNow's own auto-close closes it later;
# false only adds a work note and leaves it for a person.
SERVICENOW_RESOLVE=true
# SERVICENOW_RESOLVED_STATE=6
# Must be one of your instance's close codes (older instances use values such
# as "Closed/Resolved by Caller" or "Solved (Permanently)").
SERVICENOW_CLOSE_CODE=Resolved by caller
# More fields for every new record, as a JSON object, e.g.
# {"u_service": "Cloud hosting", "contact_type": "monitoring"}
SERVICENOW_EXTRA_FIELDS=

# ── Jira Service Management ──────────────────────────────
# Optional, like Zendesk: a request per incident in a service project, internal
# comments for updates, resolved through a workflow transition when it ends.
# JSM_SITE is the site name (yourcompany for yourcompany.atlassian.net) or its
# full URL. JSM_EMAIL is an agent's Atlassian account, and JSM_API_TOKEN that
# account's personal API token from id.atlassian.com (not an org admin key).
JSM_SITE=
JSM_EMAIL=
JSM_API_TOKEN=
# The service project's key, and the request type's name (empty: the first).
JSM_PROJECT=
JSM_REQUEST_TYPE=
# The transition that resolves a request (its name, or part of it, or its ID),
# and whether to use it; false only adds a closing comment.
JSM_TRANSITION=Resolve
JSM_RESOLVE=true
# A JSON object of more request fields, e.g. {"priority": {"name": "High"}}
JSM_EXTRA_FIELDS=

# ── Freshdesk ────────────────────────────────────────────
# Optional, like Zendesk: a ticket per incident, private notes for updates, and
# Resolved (4) or Closed (5) when it ends. FRESHDESK_DOMAIN is the helpdesk name
# (yourcompany for yourcompany.freshdesk.com) or its full URL; the API key is an
# agent's, from their profile settings. Tickets come from the requester email.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_REQUESTER_EMAIL=
# 1 low, 2 medium, 3 high, 4 urgent
FRESHDESK_PRIORITY=2
FRESHDESK_GROUP_ID=
FRESHDESK_TAGS=skyfarer,auto-raised
FRESHDESK_RESOLVE=true
FRESHDESK_RESOLVED_STATUS=4
# A JSON object of more ticket fields, e.g. {"type": "Incident"}
FRESHDESK_EXTRA_FIELDS=

# ── Postgres (always .env) ───────────────────────────────
# Used by both the poller and the docker-compose postgres service.
# If you supply DATABASE_URL it takes priority over the individual vars.
# DATABASE_URL=postgresql://skyfarer:skyfarer@db:5432/skyfarer
POSTGRES_USER=skyfarer
POSTGRES_PASSWORD=skyfarer
POSTGRES_DB=skyfarer
POSTGRES_HOST=db                         # "db" inside compose, "localhost" outside
POSTGRES_PORT=5432

# The Docker volume holding the database.
# PGDATA_VOLUME=skyfarer_pgdata

# Expose Postgres on the host for psql / pgAdmin (bind to localhost only)
POSTGRES_EXPOSE=127.0.0.1:5432

# Expose the dashboard on the host (bind to localhost only). Everyone signs in;
# behind an HTTPS proxy, also set DASHBOARD_HTTPS=true for secure cookies.
DASHBOARD_EXPOSE=127.0.0.1:8080

# ── Regions of interest ─────────────────────────────────
AWS_REGIONS=me-central-1
OVH_REGIONS=UK1,GRA,SBG
# Azure display names, matched exactly (West US is not West US 2). The feed
# describes broad events in prose, so include "Multiple Regions" to catch those,
# or use * for every event Azure lists. Leave blank to turn Azure off.
AZURE_REGIONS=UK South,West Europe,Multiple Regions
# Google Cloud location IDs, as in incidents.json: europe-west2, us-central1,
# global. Leave blank to turn Google Cloud off.
GCP_REGIONS=europe-west2,global

# Statuspage providers, matched as whole words against each incident's
# affected components and its title. Codes ending in a letter also match their
# numbered sites: LON matches LON1, fr-par matches fr-par-1. Use * for every
# incident. Leave blank to turn the provider off.
# DigitalOcean datacenters (LON1, AMS3, FRA1, NYC3...), or Global.
DIGITALOCEAN_REGIONS=LON1,AMS3,Global
# Linode/Akamai locations as the status page names them (GB-LON, DE-FRA-2,
# FR-PAR...), or Linode.com for platform-wide events.
LINODE_REGIONS=
# Cloudflare airport codes (LHR, MAN, CDG...), or a product name such as
# "CDN Cache Purge" or "Network".
CLOUDFLARE_REGIONS=
# Scaleway zones (fr-par, nl-ams-1, pl-waw...).
SCALEWAY_REGIONS=

# Hetzner locations (FSN1, NBG1, HEL1, ASH, HIL, SIN), matched against each
# notice's title, category and text. Hetzner's notices often name no location
# (network work, security advisories): add the categories Network or General
# to catch those, or use * for everything.
HETZNER_REGIONS=FSN1,NBG1,HEL1,Network

# ── Keyword filter (optional) ────────────────────────────
# Comma-separated keywords. If set, only feed entries whose title or summary
# contain at least one of these (case-insensitive) are ingested -entries
# that don't match are never written to the database. Leave blank to ingest
# everything that already matches the *_REGIONS settings.
FILTER_KEYWORDS=

# ── Feed URLs (always .env; only change them for testing) 
OVH_FEED_URL=https://public-cloud.status-ovhcloud.com/history.rss
AZURE_FEED_URL=https://rssfeed.azure.status.microsoft/en-us/status/feed/
GCP_INCIDENTS_URL=https://status.cloud.google.com/incidents.json
HETZNER_FEED_URL=https://status.hetzner.com/en.atom
# Statuspage base URLs, if one ever moves:
# DIGITALOCEAN_STATUS_URL=https://status.digitalocean.com
# LINODE_STATUS_URL=https://status.linode.com
# CLOUDFLARE_STATUS_URL=https://www.cloudflarestatus.com
# SCALEWAY_STATUS_URL=https://status.scaleway.com

# ── Polling ─────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300

# ── Zendesk ticket defaults ─────────────────────────────
ZD_TICKET_PRIORITY=high
ZD_TICKET_GROUP_ID=
ZD_TICKET_TAGS=skyfarer,auto-raised

# ── Notifications ───────────────────────────────────────
# Each channel below is on once its settings are filled in. Zendesk and
# ServiceNow always get every incident; these rules are for the channels that
# interrupt people.
# Which events to send: opened, updated, resolved. (PagerDuty never gets
# updated: its alerts have no such action.)
NOTIFY_EVENTS=opened,resolved
# Don't alert about incidents published longer ago than this. Stops a first
# start from paging someone for every old event still in the feeds.
NOTIFY_MAX_AGE_HOURS=24
# Alert about scheduled maintenance too.
NOTIFY_MAINTENANCE=false
# Keep retrying a failed delivery for this long.
NOTIFY_RETRY_HOURS=24

# ── Pushover ────────────────────────────────────────────
PUSHOVER_TOKEN=
PUSHOVER_USER=
# -2 to 2, for new incidents. 2 repeats until acknowledged.
PUSHOVER_PRIORITY=0

# ── PagerDuty ───────────────────────────────────────────
# Events API v2 integration key.
PAGERDUTY_ROUTING_KEY=
# critical, error, warning or info
PAGERDUTY_SEVERITY=error

# ── Microsoft Teams ─────────────────────────────────────
# The URL from a Teams Workflows webhook. Keep it secret: anyone holding it can
# post to the channel.
TEAMS_WEBHOOK_URL=

# ── Outbound webhook ────────────────────────────────────
# Sends each notice to any URL, for tools Skyfarer doesn't support directly.
# This describes one webhook, imported as the first; add more in the dashboard.
# Treated like the other alert channels: no old events or maintenance, and
# "resolved" only after "opened".
WEBHOOK_URL=
# POST, PUT or PATCH.
WEBHOOK_METHOD=POST
# Which events to send, if not NOTIFY_EVENTS: opened, updated, resolved.
WEBHOOK_EVENTS=
# Extra headers as a JSON object, e.g. {"Authorization": "Bearer abc123"}
WEBHOOK_HEADERS=
# Signs each request: X-Skyfarer-Signature: sha256=<HMAC-SHA256 of the body>.
WEBHOOK_SECRET=
# Leave blank to send a JSON document with every field. Otherwise the body to
# send, with {{field}} placeholders: event, incident_id, provider, region,
# title, summary, link, published, updated, noticed, update_count. With a JSON
# content type, values are escaped for use inside a JSON string, so quote them:
# WEBHOOK_TEMPLATE={"text": "{{event}}: [{{provider}}] {{region}} {{title}} {{link}}"}
WEBHOOK_TEMPLATE=
WEBHOOK_CONTENT_TYPE=application/json

# ── SNMP traps (v2c) ────────────────────────────────────
# Comma-separated host or host:port. Port defaults to 162.
SNMP_TRAP_TARGETS=
SNMP_COMMUNITY=
# Must match SKYFARER-MIB.txt.
SNMP_BASE_OID=1.3.6.1.3.77701
