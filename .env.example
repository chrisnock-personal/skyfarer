# Skyfarer -Environment Configuration
# --------------------------------------------------------
# Copy this file to .env and fill in your values.

# ── Zendesk ──────────────────────────────────────────────
# Optional, as long as at least one notification channel is set up. Leave all
# three blank to run without tickets.
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=you@example.com
ZENDESK_API_TOKEN=

# ── Postgres ─────────────────────────────────────────────
# Used by both the poller and the docker-compose postgres service.
# If you supply DATABASE_URL it takes priority over the individual vars.
# DATABASE_URL=postgresql://skyfarer:skyfarer@db:5432/skyfarer
POSTGRES_USER=skyfarer
POSTGRES_PASSWORD=skyfarer
POSTGRES_DB=skyfarer
POSTGRES_HOST=db                         # "db" inside compose, "localhost" outside
POSTGRES_PORT=5432

# The Docker volume holding the database. An install from before the rename
# to Skyfarer keeps its data in cloud-status-poller_pgdata: set that here, and
# keep POSTGRES_USER/PASSWORD/DB at the values it was created with
# (poller / poller / status_poller).
# PGDATA_VOLUME=skyfarer_pgdata

# Expose Postgres on the host for psql / pgAdmin (bind to localhost only)
POSTGRES_EXPOSE=127.0.0.1:5432

# Expose the read-only dashboard on the host (bind to localhost only)
DASHBOARD_EXPOSE=127.0.0.1:8080

# ── Regions of interest ─────────────────────────────────
AWS_REGIONS=me-central-1
OVH_REGIONS=UK1,GRA,SBG
# Azure display names, matched exactly (West US is not West US 2). The feed
# describes broad events in prose, so include "Multiple Regions" to catch those,
# or use * for every event Azure lists. Leave blank to turn Azure off.
AZURE_REGIONS=UK South,West Europe,Multiple Regions
# Google Cloud location IDs, as in incidents.json: europe-west2, us-central1,
# global. Leave blank to turn Google Cloud off.
GCP_REGIONS=europe-west2,global

# Statuspage providers, matched as whole words against each incident's
# affected components and its title. Codes ending in a letter also match their
# numbered sites: LON matches LON1, fr-par matches fr-par-1. Use * for every
# incident. Leave blank to turn the provider off.
# DigitalOcean datacenters (LON1, AMS3, FRA1, NYC3...), or Global.
DIGITALOCEAN_REGIONS=LON1,AMS3,Global
# Linode/Akamai locations as the status page names them (GB-LON, DE-FRA-2,
# FR-PAR...), or Linode.com for platform-wide events.
LINODE_REGIONS=
# Cloudflare airport codes (LHR, MAN, CDG...), or a product name such as
# "CDN Cache Purge" or "Network".
CLOUDFLARE_REGIONS=
# Scaleway zones (fr-par, nl-ams-1, pl-waw...).
SCALEWAY_REGIONS=

# Hetzner locations (FSN1, NBG1, HEL1, ASH, HIL, SIN), matched against each
# notice's title, category and text. Hetzner's notices often name no location
# (network work, security advisories): add the categories Network or General
# to catch those, or use * for everything.
HETZNER_REGIONS=FSN1,NBG1,HEL1,Network

# ── Keyword filter (optional) ────────────────────────────
# Comma-separated keywords. If set, only feed entries whose title or summary
# contain at least one of these (case-insensitive) are ingested -entries
# that don't match are never written to the database. Leave blank to ingest
# everything that already matches the *_REGIONS settings.
FILTER_KEYWORDS=

# ── Feed URLs ───────────────────────────────────────────
OVH_FEED_URL=https://public-cloud.status-ovhcloud.com/history.rss
AZURE_FEED_URL=https://rssfeed.azure.status.microsoft/en-us/status/feed/
GCP_INCIDENTS_URL=https://status.cloud.google.com/incidents.json
HETZNER_FEED_URL=https://status.hetzner.com/en.atom
# Statuspage base URLs, if one ever moves:
# DIGITALOCEAN_STATUS_URL=https://status.digitalocean.com
# LINODE_STATUS_URL=https://status.linode.com
# CLOUDFLARE_STATUS_URL=https://www.cloudflarestatus.com
# SCALEWAY_STATUS_URL=https://status.scaleway.com

# ── Polling ─────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300

# ── Zendesk ticket defaults ─────────────────────────────
ZD_TICKET_PRIORITY=high
ZD_TICKET_GROUP_ID=
ZD_TICKET_TAGS=skyfarer,auto-raised

# ── Notifications ───────────────────────────────────────
# Each channel below is on once its settings are filled in. Zendesk always gets
# every incident; these rules are for the channels that interrupt people.
# Which events to send: opened, updated, resolved. (PagerDuty never gets
# updated: its alerts have no such action.)
NOTIFY_EVENTS=opened,resolved
# Don't alert about incidents published longer ago than this. Stops a first
# start from paging someone for every old event still in the feeds.
NOTIFY_MAX_AGE_HOURS=24
# Alert about scheduled maintenance too.
NOTIFY_MAINTENANCE=false
# Keep retrying a failed delivery for this long.
NOTIFY_RETRY_HOURS=24

# ── Pushover ────────────────────────────────────────────
PUSHOVER_TOKEN=
PUSHOVER_USER=
# -2 to 2, for new incidents. 2 repeats until acknowledged.
PUSHOVER_PRIORITY=0

# ── PagerDuty ───────────────────────────────────────────
# Events API v2 integration key.
PAGERDUTY_ROUTING_KEY=
# critical, error, warning or info
PAGERDUTY_SEVERITY=error

# ── Microsoft Teams ─────────────────────────────────────
# The URL from a Teams Workflows webhook. Keep it secret: anyone holding it can
# post to the channel.
TEAMS_WEBHOOK_URL=

# ── SNMP traps (v2c) ────────────────────────────────────
# Comma-separated host or host:port. Port defaults to 162.
SNMP_TRAP_TARGETS=
SNMP_COMMUNITY=
# Must match SKYFARER-MIB.txt.
SNMP_BASE_OID=1.3.6.1.3.77701
